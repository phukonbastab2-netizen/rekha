# Copy to .env. Never commit .env or data/.
HOST=127.0.0.1
PORT=4317
PUBLIC_ORIGIN=http://127.0.0.1:4317
# At least 16 characters; no default password.
ADMIN_PASSWORD=
DATA_DIR=./data
NODE_ENV=development
# demo is explicit; production refuses demo modes.
AI_MODE=demo
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
PAYMENT_MODE=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RETENTION_DAYS=30
