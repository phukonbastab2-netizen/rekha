@@ -0,0 +1,76 @@
+import { PublicSendMediaCache } from './public-send-media-cache';
+
+const A = 'https://public.example/video.mp4';
+const B = 'https://public.example/reviews.mp4';
+const C = 'https://public.example/image.png';
+const media = (text = '1234') => ({ data: Buffer.from(text), mimetype: 'video/mp4' });
+const env = (urls: string[]) => ({ MEDIA_SEND_CACHE_URLS: JSON.stringify(urls) });
+
+describe('PublicSendMediaCache', () => {
+  it('is disabled by default and uses exact URLs only', async () => {
+    const load = jest.fn().mockResolvedValue(media());
+    const cache = new PublicSendMediaCache(load, () => ({}));
+    await cache.get(A, undefined); await cache.get(A, undefined);
+    expect(load).toHaveBeenCalledTimes(2);
+    const selected = new PublicSendMediaCache(load, () => env([A]));
+    await selected.get(A + '?version=2', undefined); await selected.get(A + '?version=2', undefined);
+    expect(load).toHaveBeenCalledTimes(4);
+  });
+
+  it('reuses a parallel miss once and gives each caller independent bytes and metadata', async () => {
+    let resolve!: (value: ReturnType<typeof media>) => void;
+    const load = jest.fn(() => new Promise<ReturnType<typeof media>>(done => { resolve = done; }));
+    const cache = new PublicSendMediaCache(load, () => env([A]));
+    const first = cache.get(A, undefined), second = cache.get(A, undefined);
+    expect(load).toHaveBeenCalledTimes(1);
+    resolve(media()); const [a,b] = await Promise.all([first, second]);
+    a.data[0] = 0; a.mimetype = 'changed';
+    expect(b.data.toString()).toBe('1234');
+    const again = await cache.get(A, undefined);
+    expect(again.data.toString()).toBe('1234'); expect(again.mimetype).toBe('video/mp4');
+    expect(load).toHaveBeenCalledTimes(1);
+  });
+
+  it('expires after TTL and evicts the least recently used entry at the byte bound', async () => {
+    let now = 0;
+    const load = jest.fn().mockResolvedValue(media());
+    const cache = new PublicSendMediaCache(load, () => env([A,B,C]), () => now, 8, 100);
+    await cache.get(A, undefined); await cache.get(B, undefined); await cache.get(A, undefined);
+    await cache.get(C, undefined); expect(cache.stats().bytes).toBe(8);
+    await cache.get(B, undefined); expect(load).toHaveBeenCalledTimes(4);
+    now = 101; await cache.get(B, undefined); expect(load).toHaveBeenCalledTimes(5);
+    expect(cache.stats()).toMatchObject({bytes:4,entries:1});
+  });
+
+  it('never caches failures or items larger than the byte bound', async () => {
+    const load = jest.fn().mockRejectedValueOnce(Error('Fetch failed')).mockResolvedValue(media('123456'));
+    const cache = new PublicSendMediaCache(load, () => env([A]), Date.now, 4);
+    await expect(cache.get(A, undefined)).rejects.toThrow('Fetch failed');
+    await cache.get(A, undefined); await cache.get(A, undefined);
+    expect(load).toHaveBeenCalledTimes(3); expect(cache.stats().bytes).toBe(0);
+  });
+
+  it('does not mix proxy sessions with direct cached content', async () => {
+    const load = jest.fn().mockResolvedValue(media());
+    const cache = new PublicSendMediaCache(load, () => env([A]));
+    await cache.get(A, undefined); await cache.get(A, 'http://proxy:8080'); await cache.get(A, 'http://proxy:8080');
+    expect(load).toHaveBeenCalledTimes(3); expect(load).toHaveBeenLastCalledWith(A, 'http://proxy:8080');
+  });
+
+  it('invalidates cache when allowlist or download cap changes', async () => {
+    let configuration: NodeJS.ProcessEnv = env([A]);
+    const load = jest.fn().mockResolvedValue(media());
+    const cache = new PublicSendMediaCache(load, () => configuration);
+    await cache.get(A, undefined); configuration = {...configuration,MEDIA_DOWNLOAD_MAX_BYTES:'3'};
+    await cache.get(A, undefined); expect(load).toHaveBeenCalledTimes(2);
+    configuration = env([]); await cache.get(A, undefined); expect(load).toHaveBeenCalledTimes(3);
+    expect(cache.stats().entries).toBe(0);
+  });
+
+  it.each(['not-json', JSON.stringify(['http://public.example/video']), JSON.stringify(['https://127.0.0.1/file']), JSON.stringify(['https://user:password@public.example/file'])])('fails closed for invalid/private selection %s', async raw => {
+    const load = jest.fn().mockResolvedValue(media());
+    const cache = new PublicSendMediaCache(load, () => ({MEDIA_SEND_CACHE_URLS:raw}));
+    await cache.get(A, undefined); await cache.get(A, undefined);
+    expect(load).toHaveBeenCalledTimes(2); expect(cache.stats().enabledUrls).toBe(0);
+  });
+});
diff --git a/src/common/media/public-send-media-cache.ts b/src/common/media/public-send-media-cache.ts
new file mode 100644
index 0000000..a205963
--- /dev/null
+++ b/src/common/media/public-send-media-cache.ts
@@ -0,0 +1,104 @@
+import { isIP } from 'node:net';
+import { isBlockedAddress } from '../security/ssrf-guard';
+import { loadRemoteMediaBuffer } from './load-remote-media';
+
+const MAX_BYTES = 64 * 1024 * 1024;
+const TTL_MS = 10 * 60 * 1000;
+const MAX_URLS = 32;
+type MediaBytes = { data: Buffer; mimetype: string };
+type Loader = (url: string, proxy: string | undefined) => Promise<MediaBytes>;
+
+/** Exact, operator-selected public URLs only. Never accepts credentials or private hosts. */
+function parseAllowlist(raw: string, ssrfAllowedHosts: string): Set<string> {
+  if (!raw || raw.length > 16384) return new Set();
+  const privateOverrides = new Set(ssrfAllowedHosts.split(',').map(value => value.trim().replace(/^\[|\]$/g, '').toLowerCase()));
+  try {
+    const values: unknown = JSON.parse(raw);
+    if (!Array.isArray(values) || values.length > MAX_URLS) return new Set();
+    const result = new Set<string>();
+    for (const value of values) {
+      if (typeof value !== 'string' || value.length > 2048) return new Set();
+      const url = new URL(value), host = url.hostname.replace(/^\[|\]$/g, '').toLowerCase();
+      if (url.protocol !== 'https:' || url.username || url.password || url.hash || privateOverrides.has(host)
+        || host === 'localhost' || host.endsWith('.localhost') || host.endsWith('.local')
+        || (isIP(host) ? isBlockedAddress(host) : !host.includes('.'))) return new Set();
+      result.add(value);
+    }
+    return result;
+  } catch { return new Set(); }
+}
+
+/** Bounded optional cache. Misses always use the original pinned, capped SSRF-safe loader. */
+export class PublicSendMediaCache {
+  private entries = new Map<string, MediaBytes & { expiresAt: number }>();
+  private pending = new Map<string, Promise<MediaBytes>>();
+  private bytes = 0;
+  private fingerprint = '';
+  private generation = 0;
+  private allowed = new Set<string>();
+
+  constructor(
+    private readonly load: Loader = (url, proxy) => loadRemoteMediaBuffer(url, proxy),
+    private readonly environment: () => NodeJS.ProcessEnv = () => process.env,
+    private readonly now: () => number = Date.now,
+    private readonly maxBytes = MAX_BYTES,
+    private readonly ttlMs = TTL_MS,
+  ) {
+    if (!Number.isSafeInteger(maxBytes) || maxBytes < 1 || maxBytes > MAX_BYTES || !Number.isSafeInteger(ttlMs) || ttlMs < 1 || ttlMs > TTL_MS) throw Error('Invalid public media cache bounds');
+  }
+
+  private configure(): void {
+    const env = this.environment();
+    // A changed allowlist or fetch-policy cap invalidates previous content immediately.
+    const fingerprint = JSON.stringify([env.MEDIA_SEND_CACHE_URLS || '', env.SSRF_ALLOWED_HOSTS || '', env.MEDIA_DOWNLOAD_MAX_BYTES || '']);
+    if (fingerprint === this.fingerprint) return;
+    this.fingerprint = fingerprint; this.generation++;
+    this.allowed = parseAllowlist(env.MEDIA_SEND_CACHE_URLS || '', env.SSRF_ALLOWED_HOSTS || '');
+    this.entries.clear(); this.pending.clear(); this.bytes = 0;
+  }
+
+  private expire(): void {
+    for (const [url, entry] of this.entries) if (entry.expiresAt <= this.now()) { this.entries.delete(url); this.bytes -= entry.data.byteLength; }
+  }
+
+  async get(url: string, sessionProxyUrl: string | undefined): Promise<MediaBytes> {
+    this.configure(); this.expire();
+    // Even a public allowlisted asset must follow a session's configured egress route.
+    if (sessionProxyUrl !== undefined || !this.allowed.has(url)) return this.load(url, sessionProxyUrl);
+    const cached = this.entries.get(url);
+    if (cached) {
+      this.entries.delete(url); this.entries.set(url, cached);
+      return { data: Buffer.from(cached.data), mimetype: cached.mimetype };
+    }
+    let flight = this.pending.get(url);
+    if (!flight) {
+      const generation = this.generation;
+      flight = this.load(url, undefined).then(result => {
+        this.configure(); this.expire();
+        if (generation === this.generation && this.allowed.has(url) && result.data.byteLength <= this.maxBytes) {
+          while (this.entries.size && this.bytes + result.data.byteLength > this.maxBytes) {
+            const oldest = this.entries.keys().next().value!;
+            const evicted = this.entries.get(oldest)!;
+            this.entries.delete(oldest); this.bytes -= evicted.data.byteLength;
+          }
