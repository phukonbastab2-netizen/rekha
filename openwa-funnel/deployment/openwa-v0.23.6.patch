+import '../../test-helpers/register-hooks.ts';
+import { test, before, afterEach } from 'node:test';
+import assert from 'node:assert/strict';
+import { createElement } from 'react';
+import type { UseQueryResult } from '@tanstack/react-query';
+import type { Channel, Chat } from '../../services/api.ts';
+
+let rtl: typeof import('@testing-library/react');
+let ChatSidebar: typeof import('./ChatSidebar.tsx').default;
+let RoleProvider: typeof import('../RoleProvider.tsx').RoleProvider;
+
+before(async () => {
+  const { installJsdomGlobals } = await import('../../test-helpers/jsdom.ts');
+  await installJsdomGlobals();
+  const { i18nReady } = await import('../../i18n/index.ts');
+  await i18nReady;
+  rtl = await import('@testing-library/react');
+  ({ RoleProvider } = await import('../RoleProvider.tsx'));
+  ({ default: ChatSidebar } = await import('./ChatSidebar.tsx'));
+});
+
+afterEach(() => rtl.cleanup());
+
+const BASE_CHAT: Chat = {
+  id: '15551234567@c.us', name: 'Saved customer', kind: 'individual', isGroup: false,
+  unreadCount: 0, timestamp: 1_700_000_000, archived: false, pinned: false, muted: false,
+};
+
+function renderChat(chat: Chat) {
+  const noop = () => {};
+  return rtl.render(createElement(RoleProvider, null, createElement(ChatSidebar, {
+    sessions: [], selectedSessionId: 's1', onSelectSession: noop, activeTab: 'chats',
+    onSwitchTab: noop, searchQuery: '', onSearchQueryChange: noop, onComposeStatus: noop,
+    formatChatTime: () => '10:00',
+    chatsTab: { loading: false, chats: [chat], onSelectChat: noop },
+    channelsTab: { engineLoading: false, supported: false, query: {} as UseQueryResult<Channel[], Error>, channels: [], onSelectChannel: noop },
+    statusTab: { loading: false, error: false, groups: [], activeContactId: null, onSelectContact: noop },
+  })));
+}
+
+test('stored-only chat shows saved-history label and actual preview, without claiming unread state', () => {
+  const { container } = renderChat({ ...BASE_CHAT, storageOnly: true, unreadCount: 8, lastMessage: 'The actual saved reply' });
+  assert.ok(rtl.screen.getByText('Saved history'));
+  assert.ok(rtl.screen.getByText('The actual saved reply'));
+  assert.equal(container.querySelector('.chat-unread-badge'), null);
+  assert.match(rtl.screen.getByText('Saved history').getAttribute('title') || '', /not in the currently linked WhatsApp history/);
+});
+
+test('stored media without a text preview says saved message, not no messages', () => {
+  renderChat({ ...BASE_CHAT, storageOnly: true });
+  assert.ok(rtl.screen.getByText('Saved message'));
+});
+
+test('offline saved history explains that WhatsApp is unavailable and makes no unread claim', () => {
+  const { container } = renderChat({ ...BASE_CHAT, storageOnly: true, nativeUnavailable: true, unreadCount: 9 });
+  assert.match(rtl.screen.getByText('Saved history').getAttribute('title') || '', /WhatsApp is temporarily unavailable/);
+  assert.equal(container.querySelector('.chat-unread-badge'), null);
+});
+
+test('native chat keeps its real unread badge and does not gain a saved-history badge', () => {
+  const { container } = renderChat({ ...BASE_CHAT, unreadCount: 3, lastMessage: 'Live reply' });
+  assert.equal(rtl.screen.queryByText('Saved history'), null);
+  assert.equal(container.querySelector('.chat-unread-badge')?.textContent, '3');
+});
