+import * as fs from 'fs';
+import { EngineStatus } from '../interfaces/whatsapp-engine.interface';
+import { WwebjsStuckAuth, type WwebjsStuckAuthHost } from './wwebjs-stuck-auth';
+
+describe('saved-login preservation during stuck authentication', () => {
+  const previous = process.env.ALLOW_AUTH_RESET;
+
+  afterEach(() => {
+    if (previous === undefined) delete process.env.ALLOW_AUTH_RESET;
+    else process.env.ALLOW_AUTH_RESET = previous;
+    jest.restoreAllMocks();
+  });
+
+  function fixture(claim = jest.fn(() => true)) {
+    const callbacks = { claimStuckAuthRecovery: claim, onError: jest.fn(), onDisconnected: jest.fn() };
+    const client = { destroy: jest.fn().mockResolvedValue(undefined) };
+    const host = {
+      logger: { warn: jest.fn() },
+      config: { sessionId: 'saved-login', sessionDataPath: './test-profiles' },
+      getClient: () => client,
+      setClient: jest.fn(),
+      setStatus: jest.fn(),
+      getCallbacks: () => callbacks,
+    } as unknown as WwebjsStuckAuthHost;
+    const remove = jest.spyOn(fs.promises, 'rm').mockResolvedValue(undefined);
+    return { recovery: new WwebjsStuckAuth(host), host, callbacks, client, remove };
+  }
+
+  it('does not delete credentials, consume recovery budget or trigger a re-pair when disabled', async () => {
+    process.env.ALLOW_AUTH_RESET = 'false';
+    const { recovery, host, callbacks, client, remove } = fixture();
+    await recovery.recoverFromStuckAuth();
+    await recovery.recoverFromStuckAuth();
+    expect(remove).not.toHaveBeenCalled();
+    expect(callbacks.claimStuckAuthRecovery).not.toHaveBeenCalled();
+    expect(callbacks.onDisconnected).not.toHaveBeenCalled();
+    expect(client.destroy).not.toHaveBeenCalled();
+    expect(host.setClient).not.toHaveBeenCalled();
+    expect(host.setStatus).toHaveBeenLastCalledWith(EngineStatus.FAILED);
+    expect(callbacks.onError).toHaveBeenCalledWith(expect.stringContaining('saved login was preserved'));
+  });
+
+  it('retains the existing recovery path when an operator explicitly enables it', async () => {
+    process.env.ALLOW_AUTH_RESET = 'true';
+    const { recovery, host, callbacks, client, remove } = fixture();
+    await recovery.recoverFromStuckAuth();
+    expect(remove).toHaveBeenCalledTimes(1);
+    expect(callbacks.claimStuckAuthRecovery).toHaveBeenCalledTimes(1);
+    expect(callbacks.onDisconnected).toHaveBeenCalledTimes(1);
+    expect(client.destroy).toHaveBeenCalledTimes(1);
+    expect(host.setStatus).toHaveBeenLastCalledWith(EngineStatus.DISCONNECTED);
+  });
+});
