PORT=4341
# Optional second loopback port used by the owner's SSH tunnel; no public host.
# OWNER_TUNNEL_PORT=4342
AUTO_CONNECT=false
# Optional: full path to an existing Chrome/Chromium binary.
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
# Private backup Worker and its server-only secret. Never commit .env.
CLOUD_BACKUP_URL=
CLOUD_BACKUP_TOKEN=
# Use the OpenWA browser dashboard without the separate mobile admin bridge.
# Omit this option to preserve the existing mobile bridge behavior.
MOBILE_ADMIN_ENABLED=false

# Existing private rmyndharis/OpenWA gateway (production); no second browser.
# WHATSAPP_PROVIDER=openwa-gateway
# OPENWA_API_URL=http://127.0.0.1:2785/api
# OPENWA_API_KEY=
# OPENWA_SESSION_ID=
# OPENWA_WEBHOOK_SECRET=
# OPENWA_ACTIVE_SINCE=original-cutover-unix-milliseconds
# Optional owner-authorized recovery of actual missed inbound leads before cutover.
# OPENWA_RECOVER_MISSED_LEADS=false
